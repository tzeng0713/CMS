# 複製這個檔案為 .env（已被 .gitignore 排除，不會進版控），填入真實值後：
#   docker compose up -d --build
#
# MySQL
MYSQL_ROOT_PASSWORD=換成一個夠長的密碼
MYSQL_USER=cms_app
MYSQL_PASSWORD=換成一個夠長的密碼

# 忘記密碼信件連結會用這個網址組出來，換成實際對外的網址（含 http(s):// 開頭）
CMS_APP_BASE_URL=http://你的VM外部IP或網域

# CORS 額外允許來源（逗號分隔）。這份 docker-compose 架構下前端由 nginx 反向代理到後端，
# 瀏覽器端屬於同源請求，通常不需要填；只有前後端分開網域部署時才要設。
CMS_CORS_ALLOWED_ORIGINS=

# 沒設定 CMS_SMTP_HOST 時系統不會寄信，忘記密碼/Email 驗證會失效
CMS_SMTP_HOST=
CMS_SMTP_PORT=587
CMS_SMTP_USERNAME=
CMS_SMTP_PASSWORD=
CMS_PASSWORD_RESET_FROM=no-reply@example.com
