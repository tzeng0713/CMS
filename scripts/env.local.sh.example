#!/usr/bin/env bash
# 複製這個檔案為 scripts/env.local.sh（該檔名已被 .gitignore 排除，不會進版控），
# 填入你自己的值後，每次啟動後端前先 source 一次：
#   source scripts/env.local.sh && ./scripts/start.sh --local
#
# 前兩個值來自 Google Cloud Console → APIs & Services → Credentials，
# 建立一組「OAuth 用戶端 ID」（類型選 Web application，
# Authorized redirect URIs 填 http://localhost:8080/api/backups/oauth/callback）。
#
# GOOGLE_OAUTH_REFRESH_TOKEN 先留空、source 這個檔案並啟動後端，
# 再打開 http://localhost:8080/api/backups/oauth/authorize 用你自己的 Google 帳號完成一次性授權，
# 頁面會顯示 refresh token，複製貼回這裡，然後重新啟動後端。

export GOOGLE_OAUTH_CLIENT_ID="你的OAuth用戶端ID"
export GOOGLE_OAUTH_CLIENT_SECRET="你的OAuth用戶端密鑰"
export GOOGLE_OAUTH_REFRESH_TOKEN=""
export GOOGLE_DRIVE_BACKUP_FOLDER_ID="你的Google Drive資料夾ID"
